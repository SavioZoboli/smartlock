# Configurações da Base de Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=db_password

# Ambiente (development ou production)
NODE_ENV=development

# Chave mestre para criptografia AES-256-GCM das senhas de credenciais de equipamentos.
# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ATENÇÃO: alterar/perder esta chave torna as senhas já cadastradas irrecuperáveis.
MASTER_KEY=