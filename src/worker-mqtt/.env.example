# Configurações da Base de Dados
URL_API=http://localhost:3000

# Configurações do MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=user
MQTT_PASS=password
MQTT_PROTOCOL=mqtt
# Prefixo dos tópicos MQTT (use "smartlock" em produção e "smartlock-dev" em desenvolvimento)
MQTT_PREFIX=smartlock-dev


# Ambiente (development ou production)
NODE_ENV=development
PORT=3001